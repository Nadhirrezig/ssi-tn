# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# ── Neon Postgres ────────────────────────────────────────────────────────────
# Neon console → your project → Connect.
# A local Postgres URL (postgresql://…@localhost:5432/…) also works: the app
# switches to the regular TCP driver for anything that is not *.neon.tech.
# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection (same, without "-pooler") — used by `prisma migrate`.
# The Vercel ↔ Neon integration calls this one DATABASE_URL_UNPOOLED.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Better Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (different value per environment)
BETTER_AUTH_SECRET=""
# Public URL of this deployment, no trailing slash. Links in auth emails use it.
BETTER_AUTH_URL="http://localhost:3000"

# ── cPanel SMTP ──────────────────────────────────────────────────────────────
# cPanel → Email Accounts → Connect Devices shows the host and ports.
SMTP_HOST="mail.example.com"
# 465 = implicit TLS (recommended), 587 = STARTTLS. Any other port is plain
# SMTP without login (e.g. a local mail catcher on 1025 for development).
SMTP_PORT="465"
SMTP_USER="support@example.com"
SMTP_PASS=""
# Use the same mailbox as SMTP_USER: most cPanel servers reject or flag mail
# whose sender differs from the authenticated account.
MAIL_FROM="SSI <support@example.com>"
# Where new-ticket and client-reply notifications go (used from Phase 2).
ADMIN_NOTIFY_EMAIL="support@example.com"

# ── Team account (only read by `pnpm admin:create`) ─────────────────────────
# Prefer passing these inline so the password never sits in a file:
#   ADMIN_NAME="Prénom Nom" ADMIN_EMAIL=… ADMIN_PASSWORD='…' pnpm admin:create
# ADMIN_NAME=""
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""   # 12 characters minimum

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin (already used for SEO); also printed in email footers.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
