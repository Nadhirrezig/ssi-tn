// Client tickets — see docs/tickets-architecture.md

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
}

/// PENDING → CONFIRMED → IN_PROGRESS → DONE, or REJECTED from any open state.
/// DONE and REJECTED are final. REJECTED is labelled « Annulé » in the UI.
enum TicketStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  DONE
  REJECTED
}

// ─── Better Auth ────────────────────────────────────────────────────────────
// Field names and types must match what Better Auth reads and writes
// (better-auth 1.7). Ids are generated by Better Auth, not the database.

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  /// Set by the seed script only — never accepted from sign-up input.
  role          Role     @default(CLIENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions       Session[]
  accounts       Account[]
  tickets        Ticket[]
  ticketMessages TicketMessage[]
  ticketEvents   TicketEvent[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Scrypt hash for email/password accounts.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Email-verification and password-reset tokens.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Auth rate-limit counters. Kept in the database because on Vercel each
/// serverless instance would otherwise count separately.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ─── Tickets ────────────────────────────────────────────────────────────────

model Ticket {
  id          String       @id @default(cuid())
  /// Public reference: SSI-{year of createdAt}-{number padded to 4}.
  number      Int          @unique @default(autoincrement())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  /// Reserved for the future fixed-choice select field.
  category    String?
  status      TicketStatus @default(PENDING)
  /// Null while the ticket is a sign-up draft waiting for email verification.
  submittedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  messages TicketMessage[]
  events   TicketEvent[]

  @@index([userId, createdAt])
  @@index([status, submittedAt])
  @@map("ticket")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  // NoAction (checked at end of statement): deleting a client cascades through
  // their tickets first, so their own messages go with them; deleting an admin
  // who has replied on someone's ticket is refused instead of erasing history.
  author    User     @relation(fields: [authorId], references: [id], onDelete: NoAction)
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_message")
}

/// Status audit trail. fromStatus is null for the submission event.
model TicketEvent {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus TicketStatus?
  toStatus   TicketStatus
  actorId    String
  actor      User          @relation(fields: [actorId], references: [id], onDelete: NoAction)
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_event")
}
